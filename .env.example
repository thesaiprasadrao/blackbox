# Copy this file to .env and fill in your values.
# All fields are optional — defaults work for a standard local Ollama setup.

# Environment name (dev / prod)
ENV=dev

# URL where Ollama is running
OLLAMA_BASE_URL=http://localhost:11434

# Seconds to wait for Ollama to finish generating a response.
# Raise this if you run large models on slow hardware.
OLLAMA_TIMEOUT=120.0
